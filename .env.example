# Variáveis de Ambiente para SES Email Marketing

# Configurações da Aplicação
APP_URL=http://127.0.0.1:5000
DEBUG=False

# Banco de Dados PostgreSQL
# Formato: postgresql://usuario:senha@host:porta/banco
DATABASE_URL=postgresql://usuario:senha@localhost:5432/ses_email_marketing

# Brevo (Sendinblue) - Serviço de Email
# Obtenha em: https://www.brevo.com/
BREVO_API_KEY=sua_chave_brevo_aqui

# Anthropic Claude - IA para Enriquecimento de Leads
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui

# Unsplash - Banco de Imagens Gratuitas
# Obtenha em: https://unsplash.com/api
UNSPLASH_ACCESS_KEY=sua_chave_unsplash_aqui

# Firecrawl - Web Scraping Inteligente (NOVO)
# Obtenha em: https://www.firecrawl.dev/
#
# Sem esta chave, o sistema usará HTTP simples para extração
# Com esta chave, o Firecrawl oferece:
# - Renderização de JavaScript
# - Melhor extração de conteúdo
# - Suporte a sites complexos
FIRECRAWL_API_KEY=sua_chave_firecrawl_aqui

# ============================================
# GUIA DE CONFIGURAÇÃO
# ============================================
#
# 1. BANCO DE DADOS (PostgreSQL)
#    - Local: sudo -u postgres psql -c "CREATE DATABASE ses_email_marketing;"
#    - Railway: Use a URL fornecida
#    - Heroku: Use DATABASE_URL fornecida
#
# 2. BREVO EMAIL
#    - Visite: https://www.brevo.com/
#    - Account Settings → API Keys → Create API Key
#    - Cole a chave em BREVO_API_KEY
#
# 3. CLAUDE (IA)
#    - Visite: https://console.anthropic.com/
#    - API Keys → Create Key
#    - Cole em ANTHROPIC_API_KEY
#
# 4. FIRECRAWL (Web Scraping)
#    - Visite: https://www.firecrawl.dev/
#    - Dashboard → API Keys → Create Key
#    - Cole em FIRECRAWL_API_KEY (opcional)
#
# 5. UNSPLASH (Imagens)
#    - Visite: https://unsplash.com/api
#    - Register → Create Application
#    - Cole em UNSPLASH_ACCESS_KEY (opcional)
#
# ============================================
